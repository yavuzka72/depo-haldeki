# Haldeki Depo — Flutter Web (GoRouter + PathUrlStrategy)
# https://depo.haldeki.com
#
# Kurulum:
#   1. flutter build web --release  (veya: ./deploy/build-web.sh)
#   2. build/web içeriğini sunucuya kopyalayın (ör. /var/www/depo.haldeki.com)
#   3. Bu dosyayı sites-available'a alıp enable edin, nginx -t && systemctl reload nginx
#
# Önemli: try_files olmadan /market, /cart vb. sayfalarda F5 → 404 olur.

server {
    listen 80;
    listen [::]:80;
    server_name depo.haldeki.com;

    # SSL terminate ediyorsanız 443 bloğuna aynı root + location'ı kopyalayın.
    # listen 443 ssl http2;
    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    root /var/www/depo.haldeki.com;
    index index.html;

    # Gzip (isteğe bağlı)
    gzip on;
    gzip_types text/plain text/css application/javascript application/json;

    # Flutter statik dosyalar — önce dosyayı dene, yoksa SPA shell
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Uzun önbellek: hash'li asset'ler
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|wasm)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # index.html ve service worker — kısa önbellek / no-cache
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /flutter_service_worker.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
